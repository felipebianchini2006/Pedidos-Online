# Server Configuration Baixar dependênciasPORT=8001
go mod download
# Database Configuration PostgreSQL connection settings Rodar localmenteDB_HOST=localhost
go run cmd/main.goDB_PORT=5432 DB_USER=postgres DB_PASSWORD=postgres DB_NAME=users_db

# Database Pool Configuration (optional) Ou usar o MakefileDB_MAX_OPEN_CONNS=25
make dev-userDB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# JWT Configuration
# IMPORTANT: Change this secret in production!
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRATION=24h

# Application Environment
# Options: development, staging, production
APP_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
# Options: debug, info, warn, error
LOG_LEVEL=info
