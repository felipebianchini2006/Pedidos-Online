# Variáveis de Ambiente - Notification Service

# =====================================
# SERVIDOR HTTP
# =====================================

# Porta do servidor HTTP (health check e métricas)
PORT=8003

# =====================================
# RABBITMQ
# =====================================

# URL de conexão do RabbitMQ
# Formato: amqp://user:password@host:port/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# =====================================
# SMTP (E-MAIL)
# =====================================

# Servidor SMTP
# Exemplos:
#   - Gmail: smtp.gmail.com
#   - Outlook: smtp-mail.outlook.com
#   - SendGrid: smtp.sendgrid.net
#   - Mailgun: smtp.mailgun.org
SMTP_HOST=smtp.gmail.com

# Porta SMTP
# - 587: TLS (StartTLS) - Recomendado
# - 465: SSL (Implícito)
# - 25: Sem criptografia (não recomendado)
SMTP_PORT=587

# Usuário SMTP (geralmente o e-mail completo)
SMTP_USER=seu-email@gmail.com

# Senha SMTP
# IMPORTANTE: Para Gmail, use "App Password" (Senha de App)
# Crie em: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=sua-senha-de-app-aqui

# E-mail remetente (From)
# Aparecerá como remetente nos e-mails enviados
EMAIL_FROM=noreply@pedidosonline.com

# =====================================
# CONFIGURAÇÃO GMAIL (Exemplo)
# =====================================
# 
# 1. Ative a verificação em 2 etapas na sua conta Google
# 2. Acesse: https://myaccount.google.com/apppasswords
# 3. Crie uma senha de app para "Mail"
# 4. Use essa senha em SMTP_PASSWORD
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx (senha de app de 16 dígitos)
# EMAIL_FROM=seu-email@gmail.com

# =====================================
# CONFIGURAÇÃO SENDGRID (Exemplo)
# =====================================
#
# 1. Crie conta em https://sendgrid.com/
# 2. Crie uma API Key em Settings > API Keys
# 3. Use "apikey" como SMTP_USER
# 4. Use a API Key como SMTP_PASSWORD
#
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxx (sua API key)
# EMAIL_FROM=noreply@seudominio.com

# =====================================
# CONFIGURAÇÃO MAILGUN (Exemplo)
# =====================================
#
# 1. Crie conta em https://mailgun.com/
# 2. Configure seu domínio
# 3. Obtenha credenciais SMTP em Sending > Domain Settings > SMTP
#
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@seu-dominio.mailgun.org
# SMTP_PASSWORD=sua-senha-mailgun
# EMAIL_FROM=noreply@seu-dominio.com

# =====================================
# OBSERVAÇÕES
# =====================================
#
# - Nunca commite este arquivo com credenciais reais no Git
# - Use .env.local ou variáveis de ambiente do sistema em produção
# - Teste a conexão SMTP com: curl -v smtp://smtp.gmail.com:587
# - Verifique logs do serviço para erros de autenticação SMTP
