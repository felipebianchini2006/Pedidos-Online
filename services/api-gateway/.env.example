# API Gateway Configuration
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Server Configuration
PORT=8000

# Service URLs
# URLs dos microserviços backend (usar nomes de serviço no Docker)
USER_SERVICE_URL=http://user-service:8001
ORDER_SERVICE_URL=http://order-service:8002

# CORS Configuration
# Origens permitidas separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
# Número de requisições permitidas por minuto por IP
RATE_LIMIT_PER_MIN=100
ENABLE_RATE_LIMITING=true

# Request Configuration
# Timeout para requisições aos serviços backend (em segundos)
REQUEST_TIMEOUT=30

# Número máximo de tentativas em caso de falha
MAX_RETRIES=3

# Logging
# Ativar logs detalhados (JSON format)
ENABLE_DETAILED_LOGS=true

# CORS Advanced
# Permitir credenciais (cookies, headers de autorização)
CORS_ALLOW_CREDENTIALS=true

# Tempo de cache para preflight requests (em segundos)
CORS_MAX_AGE=3600

# Environment
# Ambiente de execução (development, staging, production)
ENVIRONMENT=development

# Security
# Ativar middleware de segurança adicional
ENABLE_HELMET=false

# Monitoring
# Ativar endpoint de métricas Prometheus
ENABLE_METRICS=false
