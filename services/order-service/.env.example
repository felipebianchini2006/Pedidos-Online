# ==============================================================================
# Order Service - Environment Variables
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário
#
# IMPORTANTE:
# - NÃO commitar o arquivo .env (apenas .env.example)
# - JWT_SECRET deve ser o MESMO do User Service
# - Em produção, use valores seguros e não exponha credenciais
# ==============================================================================

# ==============================================================================
# Servidor HTTP
# ==============================================================================
# Porta em que o Order Service irá escutar
PORT=8002

# ==============================================================================
# MongoDB
# ==============================================================================
# URI de conexão completa do MongoDB
# Formato: mongodb://[username:password@]host[:port][/database]
# 
# Exemplos:
# - Local: mongodb://localhost:27017
# - Docker: mongodb://mongodb:27017
# - Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URI=mongodb://localhost:27017

# Nome do banco de dados
MONGO_DATABASE=orders_db

# Timeout para operações (segundos)
MONGO_TIMEOUT=10

# ==============================================================================
# JWT (JSON Web Token)
# ==============================================================================
# Secret para validação de tokens JWT
# CRÍTICO: Deve ser o MESMO secret usado pelo User Service!
# O Order Service apenas VALIDA tokens (não gera)
#
# Gere um secret seguro:
# openssl rand -base64 32
JWT_SECRET=your_super_secret_key_change_this_in_production

# ==============================================================================
# RabbitMQ
# ==============================================================================
# URL de conexão do RabbitMQ
# Formato: amqp://username:password@host:port/vhost
#
# Exemplos:
# - Local: amqp://guest:guest@localhost:5672/
# - Docker: amqp://guest:guest@rabbitmq:5672/
# - CloudAMQP: amqp://user:pass@rmq.cloudamqp.com/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ==============================================================================
# User Service
# ==============================================================================
# URL base do User Service
# Usado se houver necessidade de comunicação entre serviços
#
# Exemplos:
# - Local: http://localhost:8001
# - Docker: http://user-service:8001
# - Produção: https://api.pedidosonline.com/users
USER_SERVICE_URL=http://localhost:8001

# ==============================================================================
# Configurações de Desenvolvimento (Opcional)
# ==============================================================================
# Ambiente (development, staging, production)
# ENV=development

# Nível de log (debug, info, warn, error)
# LOG_LEVEL=info

# Habilitar CORS (true/false)
# CORS_ENABLED=true

# Origens permitidas para CORS (separadas por vírgula)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
