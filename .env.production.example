# ============================================================================
# Environment Variables for Production Deployment
# ============================================================================
# Copy this file to .env.production and fill in the values
# DO NOT commit .env.production to version control!
# ============================================================================

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_THIS_STRONG_PASSWORD>
POSTGRES_DB=users_db

# ============================================================================
# MongoDB Configuration
# ============================================================================
MONGO_URI=mongodb://mongodb:27017
MONGO_DATABASE=orders_db
MONGO_USERNAME=admin
MONGO_PASSWORD=<CHANGE_THIS_STRONG_PASSWORD>

# ============================================================================
# RabbitMQ Configuration
# ============================================================================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=<CHANGE_THIS_STRONG_PASSWORD>

# ============================================================================
# JWT Configuration
# ============================================================================
JWT_SECRET=<GENERATE_A_STRONG_SECRET_KEY_HERE>
JWT_EXPIRATION=24h

# ============================================================================
# Service URLs (Internal)
# ============================================================================
USER_SERVICE_URL=http://user-service:8001
ORDER_SERVICE_URL=http://order-service:8002
NOTIFICATION_SERVICE_URL=http://notification-service:8003
API_GATEWAY_URL=http://api-gateway:8000

# ============================================================================
# SMTP Configuration (Email Notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_EMAIL@gmail.com>
SMTP_PASSWORD=<YOUR_APP_PASSWORD>
EMAIL_FROM=noreply@pedidosonline.com

# ============================================================================
# Frontend Configuration
# ============================================================================
VITE_API_URL=https://api.pedidos-online.example.com

# ============================================================================
# Monitoring & Logging
# ============================================================================
LOG_LEVEL=info
ENABLE_METRICS=true
SENTRY_DSN=<YOUR_SENTRY_DSN_IF_USING>

# ============================================================================
# Security
# ============================================================================
ALLOWED_ORIGINS=https://pedidos-online.example.com,https://www.pedidos-online.example.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1m

# ============================================================================
# Docker Image Tags
# ============================================================================
USER_SERVICE_IMAGE=ghcr.io/felipebianchini2006/pedidos-online-user-service:latest
ORDER_SERVICE_IMAGE=ghcr.io/felipebianchini2006/pedidos-online-order-service:latest
NOTIFICATION_SERVICE_IMAGE=ghcr.io/felipebianchini2006/pedidos-online-notification-service:latest
API_GATEWAY_IMAGE=ghcr.io/felipebianchini2006/pedidos-online-api-gateway:latest
FRONTEND_IMAGE=ghcr.io/felipebianchini2006/pedidos-online-frontend:latest
