# ==================== DESENVOLVIMENTO ====================
# Estas variáveis são usadas no docker-compose.dev.yml
# Copie este arquivo para .env e ajuste conforme necessário

# ==================== SMTP (Opcional) ====================
# Necessário apenas se quiser testar envio de emails
# Para desenvolvimento, pode deixar os valores padrão

# Gmail (requer App Password)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# OU SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your_sendgrid_api_key

# OU Mailgun
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.mailgun.org
# SMTP_PASSWORD=your_mailgun_password

# ==================== NOTAS ====================
# 1. PostgreSQL, MongoDB e RabbitMQ já têm credenciais padrão
#    no docker-compose.dev.yml (não precisa configurar aqui)
#
# 2. JWT Secret também já está configurado para dev
#    (NUNCA use o secret de dev em produção!)
#
# 3. Para produção, use docker-compose.yml e configure
#    todas as variáveis de ambiente adequadamente
